extends layout

block head
  link(rel='stylesheet', href='/stylesheets/dashboard.css')

block content
  .container.mt-2
    .row.justify-content-center
      .col-lg-12
        .card.shadow-sm.mb-4
          .card-body
            .header-pill
              i.bi.bi-people-fill
              | Galerie innych użytkowników

            if otherGalleries && otherGalleries.length > 0
              .row.row-cols-1.row-cols-sm-2.row-cols-md-3.row-cols-lg-4.g-4
                each gallery in otherGalleries
                  .col
                    .card.h-100.gallery-card.border-dashed.shadow-sm.position-relative(style='cursor: pointer;', onclick=`window.location.href='/dashboard/gallery/${gallery._id}'`)
                      if user && user.role === 'admin'
                        form(action=`/dashboard/gallery/delete/${gallery._id}`, method='POST', style="position: absolute; top: 10px; right: 10px; z-index: 10;")
                          button.btn.btn-sm.btn-danger(type='submit', onclick="event.stopPropagation(); return confirm('Na pewno chcesz usunąć tę galerię (jako Admin)?');")
                            i.bi.bi-trash

                      if gallery.images && gallery.images.length > 0
                        - var coverImage = gallery.images[Math.floor(Math.random() * gallery.images.length)]
                        img.card-img-top.image-thumbnail(src=coverImage.path, alt=gallery.name, style="height: 200px; object-fit: cover;")
                      else
                        .d-flex.justify-content-center.align-items-center.bg-light(style="height: 200px;")
                          i.bi.bi-image.text-muted(style="font-size: 3rem;")
                      .card-body.d-flex.flex-column.justify-content-center.align-items-center
                        h5.card-title.mb-1.text-truncate(style="max-width: 100%;") #{gallery.name}
                        small.text-muted.mb-1 
                          i.bi.bi-person.me-1
                          | #{gallery.user ? gallery.user.username : 'Nieznany'}
                        if gallery.images
                          small.text-muted #{gallery.images.length} zdjęć
            else
              .alert.alert-warning
                i.bi.bi-exclamation-triangle.me-2
                | Brak galerii innych użytkowników.
