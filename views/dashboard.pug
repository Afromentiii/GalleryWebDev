extends layout

block head
  link(rel='stylesheet', href='/stylesheets/dashboard.css')

block content
  .container.mt-2
    .row.justify-content-center
      .col-lg-12
        .card.shadow-sm.mb-4
          .card-body
            .header-pill
              i.bi.bi-speedometer2
              | Dashboard - Moje Galerie
            if user
              .alert.alert-success.mt-3.text-center
                h5.alert-heading Witaj, #{user.username}!
                p.mb-0 Twoja rola: 
                  span.badge.bg-primary #{user.role}
            else
              .alert.alert-warning
                p Nie jesteś zalogowany.

        if user
          include add-gallery.pug
          include user-galleries.pug
