doctype html
html
  head
    title= title
    link(rel='stylesheet', href='/stylesheets/style.css')
    link(rel='stylesheet', href='/bootstrap/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css')
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap', rel='stylesheet')
    script(src='/bootstrap/js/bootstrap.bundle.min.js')
    block head
  body
    if user
      .container-fluid.p-0
        .row.g-0
          // Mini Sidebar
          nav.sidebar#sidebarMenu
            button.sidebar-toggle(type="button" onclick="document.getElementById('sidebarMenu').classList.toggle('expanded')")
              i.bi.bi-list
              span.nav-text.fs-4.fw-bold Menu
            ul.nav.flex-column.mt-2
              li.nav-item
                a.nav-link(href='/dashboard')
                  i.bi.bi-house-door
                  span.nav-text Moje Galerie
              li.nav-item
                a.nav-link(href='/dashboard/other-galleries')
                  i.bi.bi-people
                  span.nav-text Galerie innych
              if user.role === 'admin'
                li.nav-item.mt-4
                  a.nav-link.text-warning(href='/admin')
                    i.bi.bi-shield-lock
                    span.nav-text Panel administratora
            hr.text-white.mx-3.my-4
            form(action='/dashboard/logout', method='POST').px-0
              button.btn.btn-link.nav-link.w-100.text-danger.text-start(type='submit', style="border: none;")
                i.bi.bi-box-arrow-right
                span.nav-text Wyloguj się
          
          
          // Main content
          main.main-content.pt-4.px-4
            block content
    else
      block content

script.
  function showImageModal(src, description) {
    const modal = new bootstrap.Modal(document.getElementById('imageModal'));
    const modalImage = document.getElementById('modalImage');
    const modalDesc = document.getElementById('modalDescription');
    const modalTitle = document.getElementById('imageModalLabel');

    modalImage.src = src;
    modalImage.alt = description;
    modalDesc.textContent = description;
    modalTitle.textContent = 'Podgląd zdjęcia';

    modal.show();
  }